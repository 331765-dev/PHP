{
    "name": "331765-dev/php-app",
    "description": "Minimal PHP application scaffold used to bootstrap the development environment.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
